# Set a long random value before exposing the service publicly.
SARAB_API_TOKEN=replace-with-a-long-random-secret
# Comma-separated extra browser origins, if using a separate frontend domain.
SARAB_ALLOWED_ORIGINS=
# Maximum incoming HTTP request size (60 MiB default).
SARAB_MAX_UPLOAD_BYTES=62914560
# Public Render service uses the platform-provided PORT automatically.
PORT=7860

SARAB_MAX_CONCURRENT_RENDERS=1
SARAB_ACCESS_LOG=1
